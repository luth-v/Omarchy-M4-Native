# Clang 23.1.3, LLD 23.1.3 and the pinned ALARM sysroot in cross-inputs.json.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{M4_APFS_SYSROOT} OR NOT DEFINED ENV{M4_APFS_LLD})
  message(FATAL_ERROR "Set M4_APFS_SYSROOT and M4_APFS_LLD to the verified cross inputs")
endif()
set(CMAKE_SYSROOT "$ENV{M4_APFS_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-unknown-linux-gnu)
set(gcc_dir "${CMAKE_SYSROOT}/usr/lib/gcc/aarch64-unknown-linux-gnu/16.1.1")
set(CMAKE_C_FLAGS_INIT "--gcc-install-dir=${gcc_dir}")
set(CMAKE_CXX_FLAGS_INIT "--gcc-install-dir=${gcc_dir}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=$ENV{M4_APFS_LLD} --rtlib=libgcc --unwindlib=libgcc")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
