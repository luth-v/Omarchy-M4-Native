            'ddcdf32476245d0cb8d803bedcc48d721b7fc1a3677e86ccea86abc3177d01a8')

package() {
  install -Dm755 m4-apfs-reader "$pkgdir/usr/lib/omarchy-m4/j713-camera/m4-apfs-reader"
  install -Dm755 m4-camera.py "$pkgdir/usr/bin/m4-camera"
  install -Dm644 -t "$pkgdir/usr/lib/omarchy-m4/j713-camera" \
    j713_isp_d_dt.ko j713_isp_cam.ko SHA256SUMS health-on-air.py m4-camera-owner.py
  install -Dm644 m4-j713-camera.service "$pkgdir/usr/lib/systemd/system/m4-j713-camera.service"
  install -Dm644 omarchy-m4-camera.conf "$pkgdir/usr/lib/modprobe.d/omarchy-m4-camera.conf"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" MIT.txt GPL-2.0-only.txt
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" apfs-fuse-GPL-2.0-or-later.txt lzfse-BSD-3-Clause.txt
  install -Dm644 reader-SOURCE-NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/reader-SOURCE-NOTICES.md"
}
