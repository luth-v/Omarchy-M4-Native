post_install() {
  /usr/bin/python3 /usr/lib/omarchy-m4/j713-camera/m4-camera-owner.py --install || \
    echo '==> Camera tuning is unavailable; camera stays unloaded. See m4-camera and docs/j713-camera.md.'
  systemctl enable m4-j713-camera.service >/dev/null 2>&1 || true
  echo '==> Power off once, then boot to start the built-in J713 camera (m4-camera).'
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable m4-j713-camera.service >/dev/null 2>&1 || true
  echo '==> A loaded camera stays until physical power-off. Owner tuning and the hold file are kept.'
}
